---
interface Props { name: 'note' | 'notebook' | 'laptop' | 'terminal' | 'flask' | 'box' | 'arrow'; }
const { name } = Astro.props;
---
<svg class={`doodle doodle-${name}`} width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'note' && <><path d="m10 5 15-1 7 8-1 24-23 1Z"/><path d="m25 4-1 9 8-1M13 19l12-1M13 24l12-1M13 29l8-1"/></>}
  {name === 'notebook' && <><path d="m8 9 24-2 2 28-25 2Z"/><path d="M13 5v9M20 4v9M27 4v8M14 21l14-2M14 27l10-1"/></>}
  {name === 'laptop' && <><path d="m10 5 23 2-3 22-23-3ZM7 26l-5 6 26 5 9-6-7-2M13 30l9 1"/></>}
  {name === 'terminal' && <><path d="m5 7 29-1 1 27-30 1Z"/><path d="m12 15 6 5-6 6M23 26l6-1"/></>}
  {name === 'flask' && <><path d="M16 7h11M18 7v12L8 33q-2 3 2 3h23q3 0 1-3L24 19V7"/><path d="m13 27 16-1-5 9H10Z" fill="#b494bf" stroke="none"/><path d="M18 3v-1M26 2l1-1M31 8h2M18 30h1M25 32h1"/></>}
  {name === 'box' && <><path d="m5 12 15-8 15 9-1 19-14 6-15-8ZM5 12l15 8 15-7M20 20v18M13 8l15 9"/></>}
  {name === 'arrow' && <path d="m4 21 29-1-8-8M33 20l-9 10"/>}
</svg>
