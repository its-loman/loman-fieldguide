---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Projects — loman">
  <section class="page-lead">
    <div class="catalogue-label">from the workbench / ongoing</div>
    <h1><span class="highlighter">Small strange tools.</span></h1>
    <p>Things I've made while trying to understand something. Some useful, some mostly educational.</p>
  </section>
  <section class="project-list" aria-label="Projects">
    {projects.map(project => (
      <article class="project">
        <Doodle name={project.icon} /><div><span class="note-meta">{project.n}</span><h2><a href={project.href}>{project.title}</a></h2><p>{project.desc}</p></div>
        <a class="code-link" href={project.href} aria-label={`View ${project.title} code on GitHub`}>code ↗</a>
      </article>
    ))}
  </section>
  <p class="margin-note">a finished thing teaches you what a prototype can't.</p>
</BaseLayout>
