---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import { projects } from '../data/projects';
const posts = (await getCollection('fieldNotes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-mascot">
      <img src="/images/loman-snail.webp" width="420" height="280" alt="A sleepy snail in purple headphones, carrying a spiral notebook shell." fetchpriority="high" />
      <span class="mascot-note">taking the scenic route.</span>
    </div>
    <div class="hero-copy">
      <h1><span class="scribble-underline">software, notes, and<br class="hero-break" /> small strange tools</span></h1>
      <p>a personal site for code, experiments, and mild suspicion of unnecessary complexity.</p>
      <div class="paper-tags" aria-label="Explore the notebook">
        <a href="/field-notes/"># programming</a><a href="/projects/"># experiments</a><a href="/projects/"># tools</a><a href="/field-notes/"># notes</a>
      </div>
    </div>
  </section>
  <div class="home-columns">
    <section class="home-section" aria-labelledby="recent-notes">
      <div class="section-heading pencil-rule"><Doodle name="notebook" /><h2 id="recent-notes"><span class="highlighter">Recent Notes</span></h2></div>
      <div class="note-rows">
        {posts.map(post => (
          <a class="note-row" href={`/field-notes/${post.id}/`}>
            <Doodle name="note" /><span>{post.data.title}</span>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'numeric', day: 'numeric', year: 'numeric' })}</time>
          </a>
        ))}
      </div>
      <a class="section-link" href="/field-notes/"><Doodle name="arrow" /><span>View all notes</span></a>
    </section>
    <section class="home-section" aria-labelledby="recent-projects">
      <div class="section-heading pencil-rule"><Doodle name="laptop" /><h2 id="recent-projects"><span class="highlighter">Recent Projects</span></h2></div>
      <div class="project-rows">
        {projects.slice(0, 3).map(project => (
          <article class="project-row">
            <Doodle name={project.icon} /><div><h3><a href={project.href}>{project.title}</a></h3><p>{project.desc}</p></div>
            <a class="code-link" href={project.href} aria-label={`View ${project.title} code on GitHub`}>code ↗</a>
          </article>
        ))}
      </div>
      <a class="section-link" href="/projects/"><Doodle name="arrow" /><span>View all projects</span></a>
    </section>
  </div>
</BaseLayout>
