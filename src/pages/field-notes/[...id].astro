---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('fieldNotes', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={`${post.data.title} — loman`} description={post.data.description}>
  <article class="article">
    <header class="article-header">
      <div class="note-meta">Field Note {post.data.noteNumber} · {date}</div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="tags">
        {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <footer class="article-footer">
      <div class="margin-note">working notes are allowed to change.</div>
      <p><a href="/field-notes/">← back to the index</a></p>
    </footer>
  </article>
</BaseLayout>
