---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('fieldNotes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Field notes — loman" description="Notes and observations about code, systems, and the web.">
  <section class="section page-lead">
    <div class="catalogue-label">Index / field notes</div>
    <h1>Things I've written down and kept.</h1>
    <p>A running catalogue of observations, experiments, and ideas that survived long enough to be useful.</p>
  </section>

  <section class="section">
    <div class="field-index">
      {posts.map(post => (
        <a href={`/field-notes/${post.id}/`}>
          <span class="note-meta">{post.data.noteNumber}</span>
          <span class="index-title">{post.data.title}</span>
          <span class="index-date">{post.data.pubDate.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
